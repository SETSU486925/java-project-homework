<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lzj.admin.mapper.GoodsTypeMapper">

    <resultMap id="GoodsTypeMap" type="com.lzj.admin.pojo.GoodsType">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="p_id" property="pId"/>
        <result column="state" property="state"/>
        <result column="icon" property="icon"/>
    </resultMap>

    <!-- 查询分类 -->
    <select id="queryGoodsTypeTree"
            resultType="com.lzj.admin.dto.TreeDto">

        SELECT
            id,
            p_id AS pId,
            name
        FROM t_goods_type
        ORDER BY id

    </select>
    <select id="queryByParentId"
            parameterType="java.lang.Integer"
            resultMap="GoodsTypeMap">

        SELECT *
        FROM t_goods_type
        WHERE p_id=#{pId}
        ORDER BY id

    </select>

</mapper>
