<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sky.mapper.ShoppingCartMapper">


    <update id="update">
        update shopping_cart
        <set>
            <if test="number != null">
                number = #{number},
            </if>
        </set>
        where id = #{id}
    </update>

    <insert id="insert">
        insert into shopping_cart(name,user_id,dish_id,setmeal_id,dish_flavor,number,amount,image,create_time)
        values (#{name},#{userId},#{dishId},#{setmealId},#{dishFlavor},#{number},#{amount},#{image},#{createTime})
    </insert>

    <select id="selectShoppingCartByUserId" resultType="com.sky.pojo.ShoppingCart">
        select * from shopping_cart
        where user_id = #{userId}
        <if test="dishId != null">
            and dish_id = #{dishId}
        </if>
        <if test="setmealId != null">
            and setmeal_id = #{setmealId}
        </if>
        <if test="dishFlavor != null">
            and dish_flavor = #{dishFlavor}
        </if>
    </select>

    <!-- 删除单条购物车记录 -->
    <delete id="deleteShoppingCart">
        delete from shopping_cart
        where user_id = #{userId}
        <if test="dishId != null">
            and dish_id = #{dishId}
        </if>
        <if test="setmealId != null">
            and setmeal_id = #{setmealId}
        </if>
        <if test="dishFlavor != null">
            and dish_flavor = #{dishFlavor}
        </if>
    </delete>

</mapper>